rules_version = '2';

// Sicherheitsregeln von NeLuna's Pfötli Buch. Sie gelten auf dem Server von Firebase:
// was hier nicht erlaubt ist, kann auch niemand an der App vorbei tun.
// Rollen: siehe src/lib/rollen.ts (Namen müssen übereinstimmen).
service cloud.firestore {
  match /databases/{database}/documents {

    function angemeldet() {
      return request.auth != null;
    }

    function ichPfad() {
      return /databases/$(database)/documents/benutzer/$(request.auth.uid);
    }

    function aktiv() {
      return angemeldet() && exists(ichPfad()) && get(ichPfad()).data.aktiv == true;
    }

    function hatRolle(rolle) {
      return aktiv() && get(ichPfad()).data.rollen.hasAny([rolle]);
    }

    function istAdmin() {
      return hatRolle('admin');
    }

    function einrichtungPfad() {
      return /databases/$(database)/documents/system/einrichtung;
    }

    function gueltigeRollen(r) {
      return r is list && r.size() <= 7 && r.hasOnly([
        'admin', 'geschaeftsfuehrung', 'leitung_pension', 'leitung_laden',
        'verkauf', 'mitarbeit_pension', 'fahrdienst'
      ]);
    }

    function gueltigerBenutzer(d) {
      return d.keys().hasOnly(['name', 'vorname', 'nachname', 'email', 'funktion', 'pensum', 'telefon', 'rollen', 'aktiv', 'erstelltAm', 'geaendertAm'])
        && text(d, 'vorname', 60) && text(d, 'nachname', 60)
        && d.keys().hasAll(['name', 'email', 'rollen', 'aktiv'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.email is string && d.email.size() <= 200
        && d.aktiv is bool
        && gueltigeRollen(d.rollen)
        && (!('pensum' in d) || d.pensum == null || (d.pensum is int && d.pensum >= 0 && d.pensum <= 100))
        && (!('funktion' in d) || d.funktion == null || (d.funktion is string && d.funktion.size() <= 100))
        && (!('telefon' in d) || d.telefon == null || (d.telefon is string && d.telefon.size() <= 40));
    }

    match /benutzer/{uid} {
      // Alle aktiven Personen sehen das Team; das eigene Profil sieht man immer.
      allow read: if aktiv() || (angemeldet() && request.auth.uid == uid);

      // Admin legt Personen an. Ausnahme: allererste Einrichtung, dann wird man selbst Admin.
      allow create: if gueltigerBenutzer(request.resource.data) && (
        istAdmin()
        || (angemeldet()
            && request.auth.uid == uid
            && !exists(einrichtungPfad())
            && existsAfter(einrichtungPfad())
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.aktiv == true
            && request.resource.data.rollen.hasAll(['admin', 'geschaeftsfuehrung']))
      );

      // Admin ändert alles, kann sich aber nicht selbst aussperren.
      // Jede Person ändert bei sich nur Name, Vorname und Telefon.
      allow update: if gueltigerBenutzer(request.resource.data) && (
        (istAdmin()
          && request.resource.data.email == resource.data.email
          && (request.auth.uid != uid
              || (request.resource.data.aktiv == true && request.resource.data.rollen.hasAny(['admin']))))
        || (aktiv()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'vorname', 'nachname', 'telefon', 'geaendertAm']))
      );

      // Niemand wird gelöscht, nur deaktiviert (Nachvollziehbarkeit).
      allow delete: if false;
    }

    match /system/einrichtung {
      allow read: if angemeldet();
      allow create: if angemeldet()
        && getAfter(ichPfad()).data.rollen.hasAll(['admin'])
        && request.resource.data.von == request.auth.uid;
      allow update, delete: if false;
    }

    match /protokoll/{id} {
      allow create: if aktiv()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'aktion', 'details', 'zeit'])
        && request.resource.data.aktion is string;
      allow read: if istAdmin();
      allow update, delete: if false;
    }

    // ---------- Rollen je Bereich (spiegelt src/lib/rollen.ts) ----------

    function rollen() {
      return get(ichPfad()).data.rollen;
    }

    function eineVon(liste) {
      return aktiv() && rollen().hasAny(liste);
    }

    // Laden: Geschäftsführung und Leitung Laden verwalten, Verkauf bearbeitet.
    function ladenBearbeiten() { return eineVon(['geschaeftsfuehrung', 'leitung_laden', 'verkauf']); }
    function ladenVerwalten() { return eineVon(['geschaeftsfuehrung', 'leitung_laden']); }

    // Wochenbericht: Verkauf liest, Leitung Laden schreibt.
    function wbLesen() { return eineVon(['geschaeftsfuehrung', 'leitung_laden', 'verkauf']); }
    function wbSchreiben() { return eineVon(['geschaeftsfuehrung', 'leitung_laden']); }

    // Sitzungen: Team lesen alle, schreiben die Leitungen; Kader nur Geschäftsführung und Leitungen.
    function teamLesen() { return eineVon(['geschaeftsfuehrung', 'leitung_pension', 'leitung_laden', 'verkauf', 'mitarbeit_pension', 'fahrdienst']); }
    function sitzungSchreiben() { return eineVon(['geschaeftsfuehrung', 'leitung_pension', 'leitung_laden']); }
    function sitzungLoeschen() { return eineVon(['geschaeftsfuehrung']); }

    // Pension: alle sehen Belegung und Kartei; Leitung Pension und Mitarbeit Pension bearbeiten, die Leitung verwaltet.
    function pensionLesen() { return teamLesen(); }
    function pensionBearbeiten() { return eineVon(['geschaeftsfuehrung', 'leitung_pension', 'mitarbeit_pension']); }
    function pensionVerwalten() { return eineVon(['geschaeftsfuehrung', 'leitung_pension']); }

    // Fahrdienst: alle sehen den Plan; Pensionsteam und Fahrdienst bearbeiten, die Leitung Pension verwaltet.
    // Wer als Fahrer/in eingeteilt ist, setzt bei der eigenen Fahrt den Status, auch ohne Bearbeitungsrecht.
    function fahrdienstLesen() { return teamLesen(); }
    function fahrdienstBearbeiten() { return eineVon(['geschaeftsfuehrung', 'leitung_pension', 'mitarbeit_pension', 'fahrdienst']); }
    function fahrdienstVerwalten() { return eineVon(['geschaeftsfuehrung', 'leitung_pension']); }

    // Kalender: alle tragen ein; fremde Termine ändern nur Geschäftsführung und Leitungen.
    function kalenderBearbeiten() { return teamLesen(); }
    function kalenderVerwalten() { return eineVon(['geschaeftsfuehrung', 'leitung_pension', 'leitung_laden']); }

    // Kassenbuch je Standort.
    function kasseBearbeiten(standort) {
      return (standort == 'laden' && ladenBearbeiten()) || (standort == 'pension' && pensionBearbeiten());
    }
    function kasseVerwalten(standort) {
      return (standort == 'laden' && ladenVerwalten()) || (standort == 'pension' && pensionVerwalten());
    }

    function text(d, feld, max) {
      return !(feld in d) || (d[feld] is string && d[feld].size() <= max);
    }

    function betrag(d, feld) {
      return d[feld] is number && d[feld] > -1000000 && d[feld] < 1000000;
    }

    // Neue Einträge tragen immer die eigene Benutzer-ID.
    function vonMir() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.person is string && request.resource.data.person.size() <= 100;
    }

    function nurFelder(felder) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(felder);
    }

    // Eigene Einträge darf man löschen, fremde nur die Leitung.
    function eigenerOderLeitung() {
      return ladenVerwalten() || (ladenBearbeiten() && resource.data.uid == request.auth.uid);
    }

    // ---------- Laden ----------

    match /kasse/{id} {
      function gueltigeKasse(d) {
        return d.keys().hasOnly(['standort', 'datum', 'person', 'uid', 'anfang', 'bar', 'karte', 'twint', 'ausgaben', 'gezaehlt',
            'safebagBetrag', 'safebagNr', 'notiz', 'total', 'soll', 'differenz', 'wechselgeldNeu', 'abgeholt', 'abgeholtAm', 'geaendertAm',
            'hofFutter', 'hofZubehoer', 'umsatz81', 'umsatz26', 'mwst81', 'mwst26'])
          && d.standort in ['laden', 'pension']
          && id == d.standort + '_' + d.datum
          && d.datum is string && d.datum.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && betrag(d, 'anfang') && betrag(d, 'bar') && betrag(d, 'karte') && betrag(d, 'twint') && betrag(d, 'ausgaben')
          && betrag(d, 'gezaehlt') && betrag(d, 'safebagBetrag') && betrag(d, 'total') && betrag(d, 'soll')
          && betrag(d, 'differenz') && betrag(d, 'wechselgeldNeu')
          && (!('hofFutter' in d) || (d.standort == 'pension' && betrag(d, 'hofFutter') && betrag(d, 'hofZubehoer')
              && betrag(d, 'umsatz81') && betrag(d, 'umsatz26') && betrag(d, 'mwst81') && betrag(d, 'mwst26')))
          && d.abgeholt is bool && text(d, 'abgeholtAm', 10) && text(d, 'safebagNr', 40) && text(d, 'notiz', 2000);
      }
      // Einzelner Abschluss: der Standort steht in der ID (auch wenn es den Abschluss noch nicht gibt).
      allow get: if (id.matches('laden_.*') && kasseBearbeiten('laden')) || (id.matches('pension_.*') && kasseBearbeiten('pension'));
      // Listen nur mit Filter auf den eigenen Standort.
      allow list: if kasseBearbeiten(resource.data.standort);
      allow create: if kasseBearbeiten(request.resource.data.standort) && vonMir() && gueltigeKasse(request.resource.data);
      // Ganzer Abschluss neu (wer zuletzt speichert, steht drin) oder nur die Loomis-Abholung.
      allow update: if kasseBearbeiten(resource.data.standort) && gueltigeKasse(request.resource.data)
        && request.resource.data.standort == resource.data.standort
        && (vonMir() || nurFelder(['abgeholt', 'abgeholtAm']));
      allow delete: if kasseVerwalten(resource.data.standort);
    }

    match /laden_uebergabe/{id} {
      allow read: if ladenBearbeiten();
      allow create: if ladenBearbeiten() && vonMir()
        && request.resource.data.keys().hasOnly(['datum', 'erstellt', 'person', 'uid', 'kategorie', 'text', 'pendenz', 'wichtig', 'erledigt', 'erledigtVon', 'erledigtAm'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 4000
        && request.resource.data.pendenz is bool && request.resource.data.wichtig is bool && request.resource.data.erledigt is bool;
      allow update: if ladenBearbeiten() && nurFelder(['erledigt', 'erledigtVon', 'erledigtAm'])
        && request.resource.data.erledigt is bool && text(request.resource.data, 'erledigtVon', 100);
      allow delete: if eigenerOderLeitung();
    }

    match /laden_bestellungen/{id} {
      allow read: if ladenBearbeiten();
      allow create: if ladenBearbeiten() && vonMir()
        && request.resource.data.keys().hasOnly(['typ', 'datum', 'erstellt', 'person', 'uid', 'artikel', 'menge', 'lieferant', 'kunde', 'telefon', 'notiz', 'status'])
        && request.resource.data.artikel is string && request.resource.data.artikel.size() > 0 && request.resource.data.artikel.size() <= 300
        && request.resource.data.typ in ['Kundenbestellung', 'Nachbestellung']
        && request.resource.data.status in ['Offen', 'Bestellt', 'Eingetroffen', 'Abgeholt', 'Storniert'];
      allow update: if ladenBearbeiten() && nurFelder(['status'])
        && request.resource.data.status in ['Offen', 'Bestellt', 'Eingetroffen', 'Abgeholt', 'Storniert'];
      allow delete: if eigenerOderLeitung();
    }

    match /laden_reklamationen/{id} {
      allow read: if ladenBearbeiten();
      allow create: if ladenBearbeiten() && vonMir()
        && request.resource.data.keys().hasOnly(['datum', 'erstellt', 'person', 'uid', 'kunde', 'artikel', 'grund', 'loesung', 'betrag', 'status'])
        && request.resource.data.artikel is string && request.resource.data.artikel.size() > 0
        && request.resource.data.grund is string && request.resource.data.grund.size() > 0
        && betrag(request.resource.data, 'betrag')
        && request.resource.data.status in ['Offen', 'Beim Lieferanten', 'Erledigt'];
      allow update: if ladenBearbeiten() && nurFelder(['status'])
        && request.resource.data.status in ['Offen', 'Beim Lieferanten', 'Erledigt'];
      allow delete: if eigenerOderLeitung();
    }

    match /laden_loomis/{id} {
      allow read: if ladenBearbeiten();
      allow create: if ladenBearbeiten() && vonMir()
        && request.resource.data.keys().hasOnly(['typ', 'datum', 'erstellt', 'person', 'uid', 'betrag', 'notiz'])
        && betrag(request.resource.data, 'betrag') && text(request.resource.data, 'notiz', 1000);
      allow update: if false;
      allow delete: if eigenerOderLeitung();
    }

    match /laden_wochenberichte/{montag} {
      allow read: if wbLesen();
      allow create, update: if wbSchreiben() && vonMir()
        && request.resource.data.woche == montag
        && request.resource.data.keys().hasOnly(['woche', 'person', 'uid', 'gespeichert', 'zahlen',
             'umsatz', 'personal', 'sortiment', 'reklamationen', 'laden', 'anliegen', 'naechste']);
      allow delete: if ladenVerwalten();
    }

    // ---------- Sitzungen ----------

    function gueltigesProtokoll(d) {
      return d.keys().hasOnly(['datum', 'zeit', 'ort', 'leitung', 'protokoll', 'anwesend', 'abwesend', 't', 'pendenzen', 'naechste', 'gespeichert', 'uid', 'person'])
        && d.datum is string && d.anwesend is list && d.t is list && d.pendenzen is list
        && d.uid == request.auth.uid;
    }

    match /sitzungen_team/{id} {
      allow read: if teamLesen();
      allow create, update: if sitzungSchreiben() && gueltigesProtokoll(request.resource.data);
      // Pendenzen abhaken dürfen alle, die das Protokoll lesen.
      allow update: if teamLesen() && nurFelder(['pendenzen'])
        && request.resource.data.pendenzen.size() == resource.data.pendenzen.size();
      allow delete: if sitzungLoeschen();
    }

    match /sitzungen_kader/{id} {
      allow read: if sitzungSchreiben();
      allow create, update: if sitzungSchreiben() && gueltigesProtokoll(request.resource.data);
      allow delete: if sitzungLoeschen();
    }

    // ---------- Pension ----------

    function datumOk(d, feld) {
      return d[feld] is string && d[feld].matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    // Plätze je Gewichtsklasse (bis 25 kg, 25–45 kg, ab 45 kg); 0 heisst: diese Grösse passt nicht.
    function gueltigePlaetze(p) {
      return p is map && p.keys().hasOnly(['klein', 'mittel', 'gross']) && p.keys().hasAll(['klein', 'mittel', 'gross'])
        && p.klein is int && p.klein >= 0 && p.klein <= 10
        && p.mittel is int && p.mittel >= 0 && p.mittel <= 10
        && p.gross is int && p.gross >= 0 && p.gross <= 10;
    }

    match /pension_zimmer/{id} {
      allow read: if pensionLesen();
      allow write: if pensionVerwalten()
        && id.matches('zimmer-[0-9]+')
        && request.resource.data.keys().hasOnly(['name', 'maxHunde', 'plaetze', 'aktiv', 'notiz'])
        && (!('plaetze' in request.resource.data) || gueltigePlaetze(request.resource.data.plaetze))
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.maxHunde is int && request.resource.data.maxHunde >= 1 && request.resource.data.maxHunde <= 10
        && request.resource.data.aktiv is bool && text(request.resource.data, 'notiz', 500);
    }

    // Preise der Pension (CHF pro Hund); ohne Eintrag gelten die Standardpreise der App.
    match /pension_einstellungen/{id} {
      allow read: if pensionLesen();
      allow write: if pensionVerwalten() && id == 'preise'
        && request.resource.data.keys().hasOnly(['tagesbetreuung', 'uebernachtung', 'person', 'uid'])
        && request.resource.data.tagesbetreuung is number && request.resource.data.tagesbetreuung >= 0 && request.resource.data.tagesbetreuung < 10000
        && request.resource.data.uebernachtung is number && request.resource.data.uebernachtung >= 0 && request.resource.data.uebernachtung < 10000
        && vonMir();
    }

    match /pension_kunden/{id} {
      function gueltigerKunde(d) {
        return d.keys().hasOnly(['name', 'telefon', 'telefon2', 'email', 'adresse', 'notfallkontakt', 'tierarzt', 'versicherung', 'team', 'notiz',
            'nachname', 'vorname', 'plzOrt', 'geburtsdatum', 'notfallkontakt2', 'erstellt', 'person', 'uid'])
          && text(d, 'nachname', 80) && text(d, 'vorname', 80) && text(d, 'plzOrt', 100) && text(d, 'notfallkontakt2', 200)
          && (!('geburtsdatum' in d) || d.geburtsdatum == '' || datumOk(d, 'geburtsdatum'))
          && (!('team' in d) || d.team is bool)
          && text(d, 'telefon2', 40) && text(d, 'versicherung', 200)
          && d.name is string && d.name.size() > 0 && d.name.size() <= 120
          && text(d, 'telefon', 40) && text(d, 'email', 200) && text(d, 'adresse', 300)
          && text(d, 'notfallkontakt', 200) && text(d, 'tierarzt', 200) && text(d, 'notiz', 4000);
      }
      allow read: if pensionLesen();
      allow create: if pensionBearbeiten() && vonMir() && gueltigerKunde(request.resource.data);
      allow update: if pensionBearbeiten() && gueltigerKunde(request.resource.data)
        && nurFelder(['name', 'telefon', 'telefon2', 'email', 'adresse', 'notfallkontakt', 'tierarzt', 'versicherung', 'team', 'notiz',
          'nachname', 'vorname', 'plzOrt', 'geburtsdatum', 'notfallkontakt2']);
      allow delete: if pensionVerwalten();
    }

    match /pension_hunde/{id} {
      function gueltigerHund(d) {
        return d.keys().hasOnly(['kundeId', 'name', 'rasse', 'geburtsdatum', 'geschlecht', 'kastriert', 'futter', 'menge', 'medikamente',
            'allergien', 'verhalten', 'vertraeglich', 'notiz', 'impfungen', 'erstellt', 'person', 'uid',
            'gewicht', 'gewichtsklasse', 'chipnummer', 'farbe', 'fuetterungszeiten', 'leckerli', 'schlafplatz', 'kommandos',
            'aengste', 'spielverhalten', 'freilauf', 'laeufigkeit', 'tierarzt', 'tierarztTelefon', 'gesundheit', 'sozialverhalten'])
          && text(d, 'tierarzt', 200) && text(d, 'tierarztTelefon', 40) && text(d, 'gesundheit', 2000) && text(d, 'sozialverhalten', 2000)
          && (!('gewichtsklasse' in d) || d.gewichtsklasse in ['', 'klein', 'mittel', 'gross'])
          && text(d, 'gewicht', 20) && text(d, 'chipnummer', 40) && text(d, 'farbe', 100) && text(d, 'fuetterungszeiten', 500)
          && text(d, 'leckerli', 500) && text(d, 'schlafplatz', 500) && text(d, 'kommandos', 1000) && text(d, 'aengste', 1000)
          && text(d, 'spielverhalten', 1000) && text(d, 'freilauf', 500) && text(d, 'laeufigkeit', 200)
          && d.kundeId is string && d.kundeId.size() > 0
          && d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && d.kastriert is bool && d.vertraeglich is bool
          && d.impfungen is list && d.impfungen.size() <= 20
          && text(d, 'rasse', 100) && text(d, 'futter', 500) && text(d, 'menge', 200) && text(d, 'medikamente', 1000)
          && text(d, 'allergien', 500) && text(d, 'verhalten', 2000) && text(d, 'notiz', 4000);
      }
      allow read: if pensionLesen();
      allow create: if pensionBearbeiten() && vonMir() && gueltigerHund(request.resource.data);
      allow update: if pensionBearbeiten() && gueltigerHund(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['erstellt', 'person', 'uid']);
      allow delete: if pensionVerwalten();
    }

    match /pension_buchungen/{id} {
      function gueltigeBuchung(d) {
        return d.keys().hasOnly(['kundeId', 'kundeName', 'hunde', 'zimmerId', 'von', 'bis', 'status', 'leistungen', 'preis', 'bemerkung',
            'bezahlt', 'zahlungsart', 'betrag', 'bezahltAm', 'erstellt', 'person', 'uid', 'geaendertVon'])
          && d.kundeId is string && d.kundeName is string
          && d.hunde is list && d.hunde.size() >= 1 && d.hunde.size() <= 10
          && d.zimmerId is string && d.zimmerId.matches('zimmer-[0-9]+')
          && datumOk(d, 'von') && datumOk(d, 'bis') && d.von <= d.bis
          && d.status in ['Anfrage', 'Bestätigt', 'Eingecheckt', 'Abgeholt', 'Storniert']
          && d.leistungen is list && d.leistungen.size() <= 10
          && betrag(d, 'preis') && betrag(d, 'betrag') && d.bezahlt is bool
          && d.zahlungsart in ['', 'Bar', 'Karte', 'TWINT', 'Rechnung']
          && text(d, 'bezahltAm', 10) && text(d, 'bemerkung', 2000);
      }
      allow read: if pensionLesen();
      allow create: if pensionBearbeiten() && vonMir() && gueltigeBuchung(request.resource.data);
      allow update: if pensionBearbeiten() && gueltigeBuchung(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['erstellt', 'person', 'uid'])
        && request.resource.data.geaendertVon == request.auth.uid;
      allow delete: if pensionVerwalten();
    }

    // Abhakliste pro Tag: ein Dokument je Datum.
    match /pension_tagesplan/{tag} {
      allow read: if pensionBearbeiten();
      allow create, update: if pensionBearbeiten()
        && tag.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.keys().hasOnly(['erledigt', 'notizen'])
        && (!('erledigt' in request.resource.data) || request.resource.data.erledigt is map)
        && (!('notizen' in request.resource.data) || request.resource.data.notizen is map);
      allow delete: if false;
    }

    match /pension_uebergabe/{id} {
      allow read: if pensionBearbeiten();
      allow create: if pensionBearbeiten() && vonMir()
        && request.resource.data.keys().hasOnly(['datum', 'erstellt', 'person', 'uid', 'kategorie', 'text', 'pendenz', 'wichtig', 'erledigt', 'erledigtVon', 'erledigtAm'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 4000
        && request.resource.data.pendenz is bool && request.resource.data.wichtig is bool && request.resource.data.erledigt is bool;
      allow update: if pensionBearbeiten() && nurFelder(['erledigt', 'erledigtVon', 'erledigtAm'])
        && request.resource.data.erledigt is bool && text(request.resource.data, 'erledigtVon', 100);
      allow delete: if pensionVerwalten() || (pensionBearbeiten() && resource.data.uid == request.auth.uid);
    }

    // ---------- Fahrdienst und Fahrzeuge ----------

    function unveraendert(felder) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(felder);
    }

    match /fahrten/{id} {
      function gueltigeFahrt(d) {
        return d.keys().hasOnly(['datum', 'zeit', 'richtung', 'buchungId', 'kundeName', 'telefon', 'adresse', 'hunde', 'fahrerUid', 'fahrerName',
            'fahrzeugId', 'fahrzeugName', 'status', 'notiz', 'erstellt', 'person', 'uid', 'geaendertVon'])
          && datumOk(d, 'datum')
          && d.richtung in ['Hinweg', 'Rückweg']
          && d.status in ['Geplant', 'Unterwegs', 'Erledigt', 'Abgesagt']
          && d.adresse is string && d.adresse.size() > 0 && d.adresse.size() <= 300
          && d.hunde is list && d.hunde.size() <= 10
          && text(d, 'zeit', 5) && text(d, 'buchungId', 60) && text(d, 'kundeName', 120) && text(d, 'telefon', 40)
          && text(d, 'fahrerUid', 128) && text(d, 'fahrerName', 100) && text(d, 'fahrzeugId', 60) && text(d, 'fahrzeugName', 100)
          && text(d, 'notiz', 2000);
      }
      allow read: if fahrdienstLesen();
      allow create: if fahrdienstBearbeiten() && vonMir() && gueltigeFahrt(request.resource.data);
      allow update: if gueltigeFahrt(request.resource.data)
        && unveraendert(['erstellt', 'person', 'uid'])
        && request.resource.data.geaendertVon == request.auth.uid
        && (fahrdienstBearbeiten()
            || (fahrdienstLesen() && resource.data.fahrerUid == request.auth.uid && nurFelder(['status', 'notiz', 'geaendertVon'])));
      allow delete: if fahrdienstVerwalten() || (fahrdienstBearbeiten() && resource.data.uid == request.auth.uid);
    }

    match /fahrzeuge/{id} {
      function gueltigesFahrzeug(d) {
        return d.keys().hasOnly(['name', 'kennzeichen', 'kmStand', 'aktiv', 'notiz'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && d.kmStand is int && d.kmStand >= 0 && d.kmStand <= 2000000
          && d.aktiv is bool && text(d, 'kennzeichen', 20) && text(d, 'notiz', 1000);
      }
      allow read: if fahrdienstBearbeiten();
      allow create: if fahrdienstVerwalten() && gueltigesFahrzeug(request.resource.data);
      allow delete: if fahrdienstVerwalten();
      // Wer fährt, trägt den Kilometerstand nach; er kann nur steigen.
      allow update: if gueltigesFahrzeug(request.resource.data) && (
        fahrdienstVerwalten()
        || (fahrdienstBearbeiten() && nurFelder(['kmStand']) && request.resource.data.kmStand >= resource.data.kmStand)
      );
    }

    match /fahrzeug_termine/{id} {
      function gueltigerTermin(d) {
        return d.keys().hasOnly(['fahrzeugId', 'art', 'datum', 'zeit', 'garage', 'kosten', 'kmStand', 'faelligKm', 'blockiert',
            'wiederholungMonate', 'wiederholungKm', 'notiz', 'erledigt', 'erledigtAm', 'erstellt', 'person', 'uid'])
          && d.fahrzeugId is string && d.fahrzeugId.size() > 0
          && d.art in ['Reifenwechsel', 'Service', 'MFK', 'Versicherung', 'Vignette', 'Reparatur', 'Reinigung Hundeboxen', 'Problem', 'Anderes']
          && datumOk(d, 'datum')
          && betrag(d, 'kosten')
          && d.kmStand is int && d.kmStand >= 0 && d.faelligKm is int && d.faelligKm >= 0
          && d.wiederholungMonate is int && d.wiederholungMonate >= 0 && d.wiederholungMonate <= 60
          && d.wiederholungKm is int && d.wiederholungKm >= 0
          && d.blockiert is bool && d.erledigt is bool
          && text(d, 'zeit', 5) && text(d, 'garage', 120) && text(d, 'notiz', 2000) && text(d, 'erledigtAm', 10);
      }
      allow read: if fahrdienstBearbeiten();
      allow create: if fahrdienstBearbeiten() && vonMir() && gueltigerTermin(request.resource.data);
      allow update: if fahrdienstBearbeiten() && gueltigerTermin(request.resource.data) && unveraendert(['erstellt', 'person', 'uid']);
      allow delete: if fahrdienstVerwalten() || (fahrdienstBearbeiten() && resource.data.uid == request.auth.uid);
    }

    // ---------- Kalender ----------

    match /termine/{id} {
      function gueltigerKalenderTermin(d) {
        return d.keys().hasOnly(['titel', 'datum', 'bis', 'zeit', 'zeitBis', 'ebene', 'ort', 'beschreibung', 'erstellt', 'person', 'uid'])
          && d.titel is string && d.titel.size() > 0 && d.titel.size() <= 200
          && datumOk(d, 'datum') && datumOk(d, 'bis') && d.datum <= d.bis
          && d.ebene in ['Laden', 'Pension', 'Personal', 'Sitzungen', 'Firma']
          && text(d, 'zeit', 5) && text(d, 'zeitBis', 5) && text(d, 'ort', 200) && text(d, 'beschreibung', 2000);
      }
      allow read: if teamLesen();
      allow create: if kalenderBearbeiten() && vonMir() && gueltigerKalenderTermin(request.resource.data);
      allow update: if gueltigerKalenderTermin(request.resource.data) && unveraendert(['erstellt', 'person', 'uid'])
        && (kalenderVerwalten() || (kalenderBearbeiten() && resource.data.uid == request.auth.uid));
      allow delete: if kalenderVerwalten() || (kalenderBearbeiten() && resource.data.uid == request.auth.uid);
    }

    // ---------- Chat und Mitteilungen ----------

    // Gruppen nach Rolle (spiegelt GRUPPEN in src/lib/chat.ts); Direktnachrichten «dm_<uid>_<uid>» nur für die beiden.
    function kanalZugriff(k) {
      return (k == 'alle' && teamLesen())
        || (k == 'pension' && eineVon(['geschaeftsfuehrung', 'leitung_pension', 'mitarbeit_pension', 'fahrdienst']))
        || (k == 'laden' && eineVon(['geschaeftsfuehrung', 'leitung_laden', 'verkauf']))
        || (k == 'leitung' && eineVon(['geschaeftsfuehrung', 'leitung_pension', 'leitung_laden']))
        || (k.matches('dm_[A-Za-z0-9]+_[A-Za-z0-9]+') && teamLesen()
            && (k.split('_')[1] == request.auth.uid || k.split('_')[2] == request.auth.uid)
            && k.split('_')[1] < k.split('_')[2]);
    }

    match /chat/{kanal} {
      // Stand des Kanals: die letzte Nachricht, für Liste und Ungelesen-Anzeige.
      allow read: if kanalZugriff(kanal);
      allow write: if kanalZugriff(kanal)
        && request.resource.data.keys().hasOnly(['letzte', 'letzterText', 'letztePerson', 'letzteUid'])
        && request.resource.data.letzte == request.time
        && request.resource.data.letzteUid == request.auth.uid
        && request.resource.data.letztePerson is string && request.resource.data.letztePerson.size() <= 100
        && request.resource.data.letzterText is string && request.resource.data.letzterText.size() <= 200;

      match /nachrichten/{id} {
        allow read: if kanalZugriff(kanal);
        allow create: if kanalZugriff(kanal) && vonMir()
          && request.resource.data.keys().hasOnly(['text', 'uid', 'person', 'zeit', 'bildId'])
          && request.resource.data.zeit == request.time
          && request.resource.data.text is string && request.resource.data.text.size() <= 4000
          && (request.resource.data.text.size() > 0 || 'bildId' in request.resource.data)
          && (!('bildId' in request.resource.data) || (request.resource.data.bildId == id
              && existsAfter(/databases/$(database)/documents/chat/$(kanal)/bilder/$(id))));
        allow update: if false;
        // Eigene Nachrichten löschen; die Geschäftsführung darf alles löschen.
        allow delete: if kanalZugriff(kanal) && (resource.data.uid == request.auth.uid || eineVon(['geschaeftsfuehrung']));
      }

      // Fotos als verkleinertes JPEG (Data-URL), getrennt von den Nachrichten, damit der Verlauf schnell lädt.
      match /bilder/{id} {
        allow read: if kanalZugriff(kanal);
        allow create: if kanalZugriff(kanal)
          && request.resource.data.keys().hasOnly(['daten', 'uid'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.daten is string && request.resource.data.daten.size() <= 900000
          && request.resource.data.daten.matches('data:image/(jpeg|png|webp);base64,.*');
        allow update: if false;
        allow delete: if kanalZugriff(kanal) && (resource.data.uid == request.auth.uid || eineVon(['geschaeftsfuehrung']));
      }
    }

    // Wann jemand welchen Kanal zuletzt gelesen hat; nur für sich selbst.
    match /chat_gelesen/{uid} {
      allow read: if aktiv() && request.auth.uid == uid;
      allow write: if aktiv() && request.auth.uid == uid && request.resource.data.size() <= 200;
    }

    // Geräte für Push-Nachrichten (ID = Token). Lesen nur die Server-Funktionen; jede Person meldet nur eigene Geräte an.
    match /push_geraete/{token} {
      allow get: if aktiv() && resource.data.uid == request.auth.uid;
      allow create, update: if aktiv()
        && request.resource.data.keys().hasOnly(['uid', 'geraet', 'erstellt'])
        && request.resource.data.uid == request.auth.uid
        && text(request.resource.data, 'geraet', 60) && text(request.resource.data, 'erstellt', 30);
      allow delete: if angemeldet() && resource.data.uid == request.auth.uid;
    }

    // Welche Push-Nachrichten jemand bekommen will; ohne Eintrag alle.
    match /push_einstellungen/{uid} {
      allow read: if aktiv() && request.auth.uid == uid;
      allow write: if aktiv() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['gruppen', 'direkt', 'mitteilungen', 'fahrten', 'personal', 'aufgaben', 'erinnerungen'])
        && request.resource.data.values().hasOnly([true, false]);
    }

    // Mitteilungen der Geschäftsführung; alle bestätigen mit «Gelesen» (nur den eigenen Eintrag).
    match /mitteilungen/{id} {
      function gueltigeMitteilung(d) {
        return d.keys().hasOnly(['titel', 'text', 'wichtig', 'erstellt', 'person', 'uid', 'gelesen'])
          && d.titel is string && d.titel.size() > 0 && d.titel.size() <= 120
          && d.text is string && d.text.size() > 0 && d.text.size() <= 8000
          && d.wichtig is bool && d.gelesen is map && d.erstellt is string && d.erstellt.size() <= 30;
      }
      allow read: if teamLesen();
      allow create: if eineVon(['geschaeftsfuehrung']) && vonMir() && gueltigeMitteilung(request.resource.data)
        && request.resource.data.gelesen.size() == 0;
      allow update: if gueltigeMitteilung(request.resource.data) && (
        eineVon(['geschaeftsfuehrung'])
        || (teamLesen() && nurFelder(['gelesen'])
            && request.resource.data.gelesen.diff(resource.data.gelesen).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.gelesen[request.auth.uid] is string));
      allow delete: if eineVon(['geschaeftsfuehrung']);
    }

    // ---------- Personal: Dienstplan, Ferien und Abwesenheiten ----------

    // Den Wochenplan schreibt die Leitung des Bereichs (Fahrdienst gehört zur Pension); spiegelt src/lib/personal.ts.
    function dienstplanBearbeiten(b) {
      return eineVon(['geschaeftsfuehrung'])
        || (b == 'laden' && eineVon(['leitung_laden']))
        || (b in ['pension', 'fahrdienst'] && eineVon(['leitung_pension']));
    }

    function uhrzeit(d, feld) {
      return d[feld] is string && d[feld].matches('[0-2][0-9]:[0-5][0-9]');
    }

    match /dienste/{id} {
      function gueltigerDienst(d) {
        return d.keys().hasOnly(['datum', 'bereich', 'mitarbeiterUid', 'mitarbeiterName', 'von', 'bis', 'notiz', 'erstellt', 'person', 'uid'])
          && datumOk(d, 'datum')
          && d.bereich in ['laden', 'pension', 'fahrdienst']
          && d.mitarbeiterUid is string && d.mitarbeiterUid.size() > 0 && d.mitarbeiterUid.size() <= 128
          && d.mitarbeiterName is string && d.mitarbeiterName.size() <= 100
          && uhrzeit(d, 'von') && uhrzeit(d, 'bis') && d.von < d.bis
          && text(d, 'notiz', 300);
      }
      allow read: if teamLesen();
      allow create: if dienstplanBearbeiten(request.resource.data.bereich) && vonMir() && gueltigerDienst(request.resource.data);
      allow update: if dienstplanBearbeiten(resource.data.bereich) && dienstplanBearbeiten(request.resource.data.bereich)
        && gueltigerDienst(request.resource.data) && unveraendert(['erstellt', 'person', 'uid']);
      allow delete: if dienstplanBearbeiten(resource.data.bereich);
    }

    // Der Bereich passt zu den Rollen der Person: er bestimmt, wer freigibt.
    function abwesenheitBereichOk(d) {
      let r = get(/databases/$(database)/documents/benutzer/$(d.mitarbeiterUid)).data.rollen;
      return (d.bereich == 'firma' && r.hasAny(['geschaeftsfuehrung']))
        || (d.bereich == 'laden' && !r.hasAny(['geschaeftsfuehrung']) && r.hasAny(['leitung_laden', 'verkauf']))
        || (d.bereich == 'pension' && !r.hasAny(['geschaeftsfuehrung']) && r.hasAny(['leitung_pension', 'mitarbeit_pension', 'fahrdienst']));
    }

    // Laden: Leitung Laden, Pension: Leitung Pension, alles: Geschäftsführung. Leitungen nie die eigenen.
    function abwesenheitFreigeben(bereich, mitarbeiter) {
      return eineVon(['geschaeftsfuehrung'])
        || (mitarbeiter != request.auth.uid
            && ((bereich == 'laden' && eineVon(['leitung_laden'])) || (bereich == 'pension' && eineVon(['leitung_pension']))));
    }

    match /abwesenheiten/{id} {
      function gueltigeAbwesenheit(d) {
        return d.keys().hasOnly(['mitarbeiterUid', 'mitarbeiterName', 'bereich', 'art', 'von', 'bis', 'notiz', 'status',
            'entscheidUid', 'entscheidName', 'entscheidAm', 'antwort', 'erstellt', 'person', 'uid'])
          && d.mitarbeiterUid is string && d.mitarbeiterUid.size() > 0 && d.mitarbeiterUid.size() <= 128
          && d.mitarbeiterName is string && d.mitarbeiterName.size() <= 100
          && d.bereich in ['laden', 'pension', 'firma']
          && d.art in ['Ferien', 'Frei', 'Weiterbildung', 'Krank', 'Unfall', 'Militär/Zivilschutz', 'Anderes']
          && datumOk(d, 'von') && datumOk(d, 'bis') && d.von <= d.bis
          && d.status in ['Beantragt', 'Bewilligt', 'Abgelehnt']
          && text(d, 'notiz', 1000) && text(d, 'antwort', 1000) && text(d, 'entscheidUid', 128)
          && text(d, 'entscheidName', 100) && text(d, 'entscheidAm', 30);
      }
      allow read: if teamLesen();
      // Für sich selbst beantragen; wer freigeben darf, trägt auch direkt ein (z. B. Krankheit).
      allow create: if teamLesen() && vonMir() && gueltigeAbwesenheit(request.resource.data) && abwesenheitBereichOk(request.resource.data)
        && ((request.resource.data.mitarbeiterUid == request.auth.uid && request.resource.data.status == 'Beantragt')
            || abwesenheitFreigeben(request.resource.data.bereich, request.resource.data.mitarbeiterUid));
      allow update: if gueltigeAbwesenheit(request.resource.data) && unveraendert(['erstellt', 'person', 'uid', 'mitarbeiterUid', 'bereich'])
        && (abwesenheitFreigeben(resource.data.bereich, resource.data.mitarbeiterUid)
            || (resource.data.mitarbeiterUid == request.auth.uid && teamLesen()
                && resource.data.status == 'Beantragt' && request.resource.data.status == 'Beantragt'
                && nurFelder(['art', 'von', 'bis', 'notiz'])));
      // Offene Anträge zieht man selbst zurück; Entschiedenes löscht nur, wer freigibt.
      allow delete: if abwesenheitFreigeben(resource.data.bereich, resource.data.mitarbeiterUid)
        || (teamLesen() && resource.data.mitarbeiterUid == request.auth.uid && resource.data.status == 'Beantragt');
    }

    // Zeiterfassung: jede Person erfasst ihre eigene Zeit; wer Ferien freigibt, sieht und korrigiert die Zeiten des Bereichs.
    function zeitLesen(d) {
      return teamLesen() && (d.mitarbeiterUid == request.auth.uid
        || eineVon(['geschaeftsfuehrung'])
        || (d.bereich == 'laden' && eineVon(['leitung_laden']))
        || (d.bereich == 'pension' && eineVon(['leitung_pension'])));
    }

    match /zeiten/{id} {
      function gueltigeZeit(d) {
        return d.keys().hasOnly(['mitarbeiterUid', 'mitarbeiterName', 'bereich', 'datum', 'von', 'bis', 'pause', 'notiz',
            'geaendertVon', 'geaendertName', 'erstellt', 'person', 'uid'])
          && d.mitarbeiterUid is string && d.mitarbeiterUid.size() > 0 && d.mitarbeiterUid.size() <= 128
          && d.mitarbeiterName is string && d.mitarbeiterName.size() <= 100
          && d.bereich in ['laden', 'pension', 'firma']
          && datumOk(d, 'datum') && uhrzeit(d, 'von')
          && (d.bis == '' || (uhrzeit(d, 'bis') && d.bis > d.von))
          && d.pause is int && d.pause >= 0 && d.pause <= 600
          && text(d, 'notiz', 300) && text(d, 'geaendertVon', 128) && text(d, 'geaendertName', 100);
      }
      function zeitSchreiben(d) {
        return d.mitarbeiterUid == request.auth.uid || abwesenheitFreigeben(d.bereich, d.mitarbeiterUid);
      }
      allow read: if zeitLesen(resource.data);
      allow create: if teamLesen() && vonMir() && gueltigeZeit(request.resource.data) && abwesenheitBereichOk(request.resource.data)
        && zeitSchreiben(request.resource.data);
      allow update: if teamLesen() && gueltigeZeit(request.resource.data) && zeitSchreiben(resource.data)
        && unveraendert(['erstellt', 'person', 'uid', 'mitarbeiterUid', 'bereich'])
        && request.resource.data.geaendertVon == request.auth.uid;
      allow delete: if teamLesen() && zeitSchreiben(resource.data);
    }

    // ---------- Aufgaben ----------

    match /aufgaben/{id} {
      function gueltigeAufgabe(d) {
        return d.keys().hasOnly(['titel', 'beschreibung', 'bereich', 'zustaendigUid', 'zustaendigName', 'faellig', 'wiederholung',
            'erledigt', 'erledigtVon', 'erledigtAm', 'erstellt', 'person', 'uid'])
          && d.titel is string && d.titel.size() > 0 && d.titel.size() <= 200
          && d.bereich in ['Laden', 'Pension', 'Fahrdienst', 'Firma']
          && (d.faellig == '' || datumOk(d, 'faellig'))
          && d.wiederholung in ['', 't1', 'w1', 'w2', 'm1', 'm3', 'm6', 'm12']
          && (d.wiederholung == '' || d.faellig != '')
          && d.erledigt is bool
          && text(d, 'beschreibung', 4000) && text(d, 'zustaendigUid', 128) && text(d, 'zustaendigName', 100)
          && text(d, 'erledigtVon', 100) && text(d, 'erledigtAm', 30);
      }
      allow read: if teamLesen();
      allow create: if teamLesen() && vonMir() && gueltigeAufgabe(request.resource.data);
      // Ändern: wer sie erstellt hat, wer zuständig ist, die Geschäftsführung. Abhaken: alle
      // (bei wiederkehrenden rückt dabei nur die Fälligkeit vor).
      allow update: if teamLesen() && gueltigeAufgabe(request.resource.data) && unveraendert(['erstellt', 'person', 'uid'])
        && (eineVon(['geschaeftsfuehrung'])
            || resource.data.uid == request.auth.uid
            || resource.data.zustaendigUid == request.auth.uid
            || nurFelder(['erledigt', 'erledigtVon', 'erledigtAm'])
            || (resource.data.wiederholung != '' && nurFelder(['faellig', 'erledigtVon', 'erledigtAm'])
                && request.resource.data.faellig > resource.data.faellig));
      allow delete: if eineVon(['geschaeftsfuehrung']) || (teamLesen() && resource.data.uid == request.auth.uid);
    }

    // ---------- Dokumente ----------

    // Die Leitungen sehen alles (auch ungefilterte Listen), das übrige Team nur «alle».
    function dokumentLesen(fuer) {
      return sitzungSchreiben() || (teamLesen() && fuer == 'alle');
    }

    match /dokumente/{id} {
      function gueltigesDokument(d) {
        return d.keys().hasOnly(['titel', 'kategorie', 'inhalt', 'link', 'fuer', 'datei', 'erstellt', 'geaendert', 'person', 'uid'])
          && d.titel is string && d.titel.size() > 0 && d.titel.size() <= 200
          && d.kategorie in ['Organisationshandbuch', 'Reglemente', 'Anleitungen', 'Formulare', 'Anderes']
          && d.fuer in ['alle', 'leitung']
          && text(d, 'inhalt', 60000)
          && d.link is string && d.link.size() <= 1000 && (d.link == '' || d.link.matches('https?://[^ ]+'))
          && (!('datei' in d) || (d.datei is map
              && d.datei.keys().hasOnly(['schluessel', 'name', 'typ', 'groesse', 'teile'])
              && d.datei.schluessel is string && d.datei.schluessel.matches('[A-Za-z0-9]{1,40}')
              && d.datei.name is string && d.datei.name.size() <= 200
              && d.datei.typ is string && d.datei.typ.size() <= 100
              && d.datei.groesse is int && d.datei.groesse > 0 && d.datei.groesse <= 5242880
              && d.datei.teile is int && d.datei.teile >= 1 && d.datei.teile <= 12));
      }
      allow read: if dokumentLesen(resource.data.fuer);
      allow create, update: if eineVon(['geschaeftsfuehrung']) && vonMir() && gueltigesDokument(request.resource.data);
      allow delete: if eineVon(['geschaeftsfuehrung']);

      // Dateiinhalt in Teilen («<schlüssel>_<nr>», Data-URL zerschnitten); lesen darf, wer das Dokument sieht.
      match /teile/{teil} {
        allow read: if dokumentLesen(get(/databases/$(database)/documents/dokumente/$(id)).data.fuer);
        allow create, update: if eineVon(['geschaeftsfuehrung'])
          && teil.matches('[A-Za-z0-9]{1,40}_[0-9]{1,2}')
          && request.resource.data.keys().hasOnly(['daten'])
          && request.resource.data.daten is string && request.resource.data.daten.size() <= 750000;
        allow delete: if eineVon(['geschaeftsfuehrung']);
      }
    }

    // Alles andere ist gesperrt, bis ein Modul eigene Regeln bekommt.
    match /{pfad=**} {
      allow read, write: if false;
    }
  }
}
