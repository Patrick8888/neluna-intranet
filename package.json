{
  "name": "neluna-intranet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:regeln": "firebase emulators:exec --only firestore --project demo-neluna \"vitest run tests --no-file-parallelism\"",
    "emulator": "firebase emulators:start --only auth,firestore --project demo-neluna",
    "deploy": "npm run build && firebase deploy --only hosting,firestore"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.34.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
