# Web-App-Konfiguration aus der Firebase-Konsole (Projekteinstellungen > Allgemein > Deine Apps).
# Diese Werte sind nicht geheim; der Schutz der Daten liegt in firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Nur lokal: mit den Firebase-Emulatoren statt dem echten Projekt arbeiten
VITE_EMULATOR=false
